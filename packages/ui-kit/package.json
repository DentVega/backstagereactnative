{
  "name": "@dentvega/ui-kit",
  "version": "0.1.1",
  "description": "Themed React Native primitives and design tokens used by the miniapp host and its miniapps (shared as a Module Federation singleton).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DentVega/backstagereactnative.git",
    "directory": "packages/ui-kit"
  },
  "homepage": "https://github.com/DentVega/backstagereactnative/tree/main/packages/ui-kit#readme",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:dist": "node ../../scripts/check-dist-imports.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-test-renderer": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "@types/jest": "^29.5.14",
    "@react-native/babel-preset": "0.76.6",
    "babel-jest": "^29.7.0"
  }
}
